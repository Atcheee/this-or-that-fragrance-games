{
  "name": "scenthub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:catalog": "tsx scripts/build-catalog-db.ts",
    "generate:atlas": "tsx scripts/generate-fragrance-atlas.ts",
    "refresh:clones": "tsx scripts/import-clone-data.ts",
    "upload:catalog": "node --env-file-if-exists=.env.local --import tsx scripts/upload-catalog-db.ts",
    "upload:bottle": "node --env-file=.env.local --import tsx scripts/upload-bottle-image.ts",
    "upload:atlas": "node --env-file=.env.local --import tsx scripts/upload-fragrance-atlas.ts",
    "predev": "node scripts/ensure-catalog-db.mjs",
    "dev": "next dev",
    "prebuild": "node --env-file-if-exists=.env.local scripts/fetch-catalog-db.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test src/**/*.test.ts",
    "refresh:fragrantica": "tsx scripts/refresh-fragrantica.ts",
    "refresh:whats-new": "tsx scripts/refresh-whats-new.ts",
    "scrape:note-prominence": "tsx scripts/scrape-note-prominence.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@next/third-parties": "^16.2.12",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@vercel/blob": "^2.6.1",
    "gsap": "^3.15.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "sharp": "$sharp"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@9.15.9",
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ],
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
