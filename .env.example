# Public Supabase project settings (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only. Required for permanent self-service account deletion and
# community clone-accuracy voting (guest + signed-in votes).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# Production site URL.
NEXT_PUBLIC_SITE_URL=https://scenthub.se

# Google integrations. Configure either GTM or GA4, not both. GTM wins when
# both are present. Search Console verification is server-only metadata.
# NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=GTM-REPLACE_ME
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-REPLACE_ME
# GOOGLE_SITE_VERIFICATION=REPLACE_ME

# Vercel Blob (private store). Holds atlas data and data/catalog.db.gz.
# Connect the store to the Scenthub Vercel project (Storage → Blob → Projects),
# then `vercel env pull`. This token must be available during Vercel builds.
# Upload map data with: npm run upload:atlas
# Upload the generated SQLite catalog with: npm run upload:catalog
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_ME
# BLOB_STORE_ID=YOUR_STORE_ID
# Optional overrides:
# CATALOG_BLOB_PATH=data/catalog.db.gz
# ATLAS_BLOB_PATH=data/fragrance-atlas.json
# ATLAS_BLOB_URL=https://YOUR_STORE_ID.private.blob.vercel-storage.com/data/fragrance-atlas.json
# BLOB_ATLAS_BASE_URL=https://YOUR_STORE_ID.private.blob.vercel-storage.com
